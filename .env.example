# ── English Explorer — env vars ────────────────────────────────
# Copy ke .env lalu isi nilainya.

# Password login (single user, static). WAJIB diisi.
APP_PASSWORD=ganti-passwordku

# Database SQLite (file lokal). Default: file:./data/app.db
DATABASE_URL=file:./data/app.db

# ── LLM utama: Groq (cepat; dipanggil duluan) ──────────────────
# API key dari https://console.groq.com
GROQ_API_KEY=
# Endpoint OpenAI-compatible Groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model Groq (contoh: openai/gpt-oss-120b, openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# ── LLM fallback: Poolside (dipakai kalau Groq gagal/limit) ────
# API key dari https://platform.poolside.ai
POOLSIDE_API_KEY=
# Endpoint OpenAI-compatible
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1
# Ambil daftar model terbaru dari GET {POOLSIDE_BASE_URL}/models
POOLSIDE_MODEL=

# ── Translation: Lara Translate (opsional; kosong = fallback LLM) ──
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
# Kuota karakter per bulan (Free plan resmi: 10000)
LARA_MONTHLY_CHAR_LIMIT=10000

# ── Review ─────────────────────────────────────────────────────
# Maksimum kartu baru yang masuk antrian review per hari
NEW_CARDS_PER_DAY=8
# Jumlah soal latihan harian yang digenerate dari library
DAILY_QUIZ_SIZE=20

# ── Guardrail LLM ──────────────────────────────────────────────
# Batas panggilan LLM per hari (hemat biaya)
DAILY_LLM_CALL_LIMIT=200

# ── Sesi login ─────────────────────────────────────────────────
# Lama sesi login (hari) sebelum diminta masuk lagi. Default 30.
SESSION_TTL_DAYS=30
# Port server (untuk `npm start`). Default 3000.
PORT=3000
